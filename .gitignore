# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
dist/
build/

# Virtual envs
.venv*/
venv/

# IDE / OS
.idea/
.vscode/
.DS_Store

# ── data/ ──────────────────────────────────────────────────────────────────
# Caches, logs, runtime state and model artefacts stay local (regenerable or
# machine-specific). A few small files are versioned below.
data/*
!data/scan_config.json
!data/signal_model.json
# Symbol lists: NSE blocks non-Indian IPs, so cloud deploys need these copies.
!data/nifty50_symbols.csv
!data/nifty100_symbols.csv
!data/nifty500_symbols.csv

# ── android/ ───────────────────────────────────────────────────────────────
# Source is versioned; the bootstrapped toolchain and build outputs are not.
android/.android-sdk/
android/.jdk/
android/.gradle*/
android/.downloads/
android/manual-build/
android/local.properties
android/debug.keystore
android/*.apk
android/*.idsig

# Tunnels
/tmp/cloudflared
